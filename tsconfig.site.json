{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "scripts/site",
    "outDir": "scripts/site",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["scripts/site/build-site.ts"],
  "exclude": ["scripts/site/build-site.js"]
}
